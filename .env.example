# agent-chat — docker compose overrides. Copy to `.env` and adjust as needed.
# Every value has a safe default baked into docker-compose.yml; this file only
# exists so you can override without editing the compose file.

# --- Host port mappings ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
MCP_PORT=8100

# --- Frontend ---
# Base URL the browser uses to reach the gateway (host-visible).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- LLM: gemma via Novita's OpenAI-compatible endpoint (https://novita.ai) ---
# Single key shared by ALL MCP agents (orchestrator, web_agent, doc_analyzer,
# image_analyzer). REQUIRED — there is no mock LLM fallback; agents raise a
# configuration error without it.
GEMMA_API_KEY=

# --- Thread memory (PostgreSQL, LangGraph checkpointer) ---
# Credentials for the compose-managed postgres service; the mcp service derives
# ORCHESTRATOR_DATABASE_URL from them. For local (non-docker) runs set
# ORCHESTRATOR_DATABASE_URL yourself, or leave it unset for the in-memory
# fallback (no cross-restart persistence).
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent_chat

# --- LangSmith tracing (optional) ---
# Traces every LangChain/LangGraph call from ALL MCP agents (orchestrator,
# web_agent, doc_analyzer, image_analyzer). Leave TRACING=false / key empty
# to disable; no code depends on these being set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=gemma-chat

# --- Timeout budgets ---
# Nested per call, never summed: one LLM attempt (30) or one gate call (31) sits inside
# one turn (60), which sits inside the gateway request (66).
# Per-attempt LLM HTTP timeout for every agent; max_retries=1, so one hung call is 2x this.
LLM_REQUEST_TIMEOUT_S=30
# The orchestrator's own turn budget. Below the gateway ceiling on purpose: an outer
# timeout can only produce a transport error, an inner one still holds a live code path
# and can answer with a typed "turn_timeout" the UI shows as a retry button.
ORCHESTRATOR_TURN_BUDGET_S=60
# Gateway backstop for one turn; the orchestrator's own budget fires first.
GATEWAY_ORCHESTRATOR_TIMEOUT_S=66

# --- Rate limiting (defence in depth: gateway + orchestrator, TASK
# 2026-08-05-rate-limit-gateway-orchestrator) -----------------------------------
# Gateway: per-remote-address limit on POST /api/chat and /api/chat/files, slowapi
# limit-string syntax (e.g. "30/minute"). Empty string disables the gate.
GATEWAY_RATE_LIMIT_DEFAULT=30/minute
# Orchestrator: independent limits (requests per minute) so a caller reaching it
# directly, bypassing the gateway, is still bounded. <=0 disables that bucket.
ORCHESTRATOR_RATE_LIMIT_THREAD_RPM=20
ORCHESTRATOR_RATE_LIMIT_GLOBAL_RPM=60

# Tavily API key — live web search for web_agent (https://app.tavily.com).
TAVILY_API_KEY=

# --- Guardrails gate ---------------------------------------------------------
# The safety gate is a separate agent the orchestrator calls over HTTP, and
# check_input is fail-closed: if the gate is unreachable, EVERY turn is rejected.
# So the address matters more than any threshold below it.
#
# DO NOT SET GUARDRAILS_URL HERE. Each stack sets it to the only value that is
# routable from where the orchestrator actually runs, and a value in .env
# overrides both — breaking whichever stack it does not match:
#   make up   -> http://guardrails:8200/mcp   (Compose network name; unresolvable
#                                              from the host)
#   make dev  -> http://127.0.0.1:8200/mcp    (host loopback; unroutable from
#                                              inside a container)
# Everything below IS yours to tune and applies to both stacks identically.

# Published/bound port of the gate. Changing it moves the gate in both stacks;
# the derived URLs follow automatically.
GUARDRAILS_PORT=8200

# Orchestrator -> gate client budget for one call. NOT a lever for making the
# stack feel faster: the gate's own judge budget is 8s (below), so a client
# timeout under that cuts off healthy verdicts and manufactures outages.
GUARDRAILS_TIMEOUT_S=15

# Output-path retry ladder (orchestrator side). Two attempts of GUARDRAILS_TIMEOUT_S
# with a flat 1s gap = 31s worst case; the deadline is the ceiling on the phase and
# must stay above one full ladder.
GUARDRAILS_RETRY_ATTEMPTS=2
GUARDRAILS_RETRY_BASE_S=1
GUARDRAILS_RETRY_FACTOR=1
GUARDRAILS_OUTPUT_DEADLINE_S=35

# The gate's LLM judge, on the same provider as the agents (GEMMA_API_KEY) but with
# its OWN budget: inheriting the agents' 30s would make a hung gate indistinguishable
# from a down one and fire the fail-closed path on healthy traffic.
GUARDRAILS_JUDGE_TIMEOUT_S=40
# Cap on what the judge sees per call, for large documents. 0 disables the cap.
GUARDRAILS_JUDGE_MAX_CHARS=60000
# Clinical questions are answered with a disclaimer; there is no moderator queue.
GUARDRAILS_MEDICAL_DISCLAIMER=true
