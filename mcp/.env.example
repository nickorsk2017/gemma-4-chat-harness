# Copy to .env and fill in. All agents' LLM/vision calls run through gemma
# (google/gemma-4-31b-it:free @ https://integrate.api.nvidia.com/v1) — the single
# key below is REQUIRED; there is no mock LLM fallback.
GEMMA_API_KEY=

# --- master_orchestrator ---
# The orchestrator's own budget for one turn. Below the gateway ceiling (66) on purpose:
# an outer timeout can only produce a transport error, an inner one still holds a live
# code path and can answer with a typed "turn_timeout" the UI shows as a retry button.
ORCHESTRATOR_TURN_BUDGET_S=60

# --- LangSmith tracing (optional, all agents) ---
# For local (non-docker) runs; in the composed stack docker-compose.yml
# forwards these to the mcp service and stdio sub-agents inherit them.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=gemma-chat

# Per-attempt LLM HTTP timeout (all agents). max_retries=1, so one hung call is 2x this
# and must die inside ORCHESTRATOR_TURN_BUDGET_S rather than outliving the turn.
LLM_REQUEST_TIMEOUT_S=30

# --- guardrails gate ---
# Where the orchestrator and doc_analyzer reach the safety gate. In the composed
# stack this is the internal service name; for a native run point it at localhost.
GUARDRAILS_URL=http://localhost:8200
# Client-side budget for one gate call. The gate's own judge timeout is separate and
# lives in the guardrails service (GUARDRAILS_JUDGE_TIMEOUT_S=8), which is why this is 15
# and not less: a shorter client budget would cut off healthy verdicts.
GUARDRAILS_TIMEOUT_S=15
# Output-path retry ladder: two attempts of 15s with a flat 1s gap = 31s worst case
# against a hung gate. The gap is flat, not exponential — with two attempts there is one
# gap, and it exists so a restarting gate can come back. The deadline is the ceiling on
# the phase and must stay above one full ladder. These ARE agent_core's own defaults:
# a process that sets nothing behaves like one that sets everything.
GUARDRAILS_RETRY_ATTEMPTS=2
GUARDRAILS_RETRY_BASE_S=1
GUARDRAILS_RETRY_FACTOR=1
GUARDRAILS_OUTPUT_DEADLINE_S=35
