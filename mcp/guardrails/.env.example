# guardrails service — copy to .env for a native run. In the composed stack these
# come from docker-compose.yml.

# The judge runs on the same provider as the agents.
GEMMA_API_KEY=

# Judge budget. Deliberately much shorter than the agents' LLM_REQUEST_TIMEOUT_S:
# a gate that hangs for 90s is indistinguishable from a gate that is down.
GUARDRAILS_JUDGE_TIMEOUT_S=8
# Cap on what the judge sees; whole documents pass through this gate.
GUARDRAILS_JUDGE_MAX_CHARS=6000
# The model runs on every checked text (TASK A3-2); there is no switch for it.

# Medical path: the clinical turn is answered and the reply carries a disclaimer.
# There is no held turn and no moderator queue — the doctor reading the answer is
# the human in the loop.
GUARDRAILS_MEDICAL_DISCLAIMER=true

# Cascade thresholds.
# No lexicon threshold: keywords supply evidence, they decide nothing (PLAN D12).
GUARDRAILS_CHECK_INJECTION=true
# Ask the model for unstructured personal data (names, addresses) alongside its verdict.
GUARDRAILS_PII_MODEL_ENTITIES=true
GUARDRAILS_JUDGE_THRESHOLD=0.6
GUARDRAILS_PII_SCORE_THRESHOLD=0.5

